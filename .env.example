# StyleAI environment variables
# Copy to .env and fill in values. Never commit .env.
# See docs/ENVIRONMENT.md for what each variable does and which environment needs it.
#
# Missing required production secrets must fail the process. Do not substitute fake values.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Supabase (required for real auth, database, and storage)
# Create a project at https://supabase.com — Free plan is enough for development.
# The anon/publishable key is public by design. The service-role key is SECRET.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth
# Google OAuth is free. Create OAuth client IDs in Google Cloud Console.
# Do not enable a skip-auth or demo login path.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# -----------------------------------------------------------------------------
# AI providers (server-only)
# Do not put these in EXPO_PUBLIC_* — they must never ship in the client bundle.
# OpenAI is the recommended V1 vision + reasoning provider. See docs/AI_SYSTEM.md.
# Creating an OpenAI account and using the API is PAID (usage-based). Do not
# activate until the owner explicitly approves. See docs/COST_AND_APPROVALS.md.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# Optional second provider. Do not use Gemini Free for user photos — Google
# uses free-tier content to improve its products. Paid Gemini does not.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Product providers (server-only)
# eBay Browse API: free developer registration, ~5,000 calls/day default.
# See docs/PRODUCT_DATA.md and docs/COST_AND_APPROVALS.md.
# -----------------------------------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox
PRODUCT_CACHE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Billing (not required until Phase 5)
# RevenueCat is free until $2,500 monthly tracked revenue.
# Stripe processes web payments (fees apply). Apple ($99/yr) and Google Play
# ($25 once) are required to sell mobile subscriptions. Do not create paid
# developer accounts automatically.
# -----------------------------------------------------------------------------
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Plans / entitlements (configuration, not prices hardcoded in UI)
# -----------------------------------------------------------------------------
FREE_MAX_WARDROBE_ITEMS=40
FREE_MAX_OUTFIT_GENERATIONS_PER_MONTH=8
FREE_MAX_SAVED_OUTFITS=10
FREE_MAX_PRODUCT_SEARCHES_PER_MONTH=20
PRO_MAX_WARDROBE_ITEMS=250
PRO_MAX_OUTFIT_GENERATIONS_PER_MONTH=80
PRO_MAX_SAVED_OUTFITS=100
PRO_MAX_PRODUCT_SEARCHES_PER_MONTH=200

# -----------------------------------------------------------------------------
# Rate limits
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_HOUR=10
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_PRODUCT_SEARCH_PER_HOUR=30
RATE_LIMIT_SIGNUP_PER_IP_PER_DAY=5

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Admin
# Server-side only. Comma-separated user UUIDs. Never a client-side password.
# -----------------------------------------------------------------------------
ADMIN_USER_IDS=
